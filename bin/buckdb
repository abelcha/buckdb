#!/bin/sh

# Find and set DYLD_LIBRARY_PATH for DuckDB native module
if [ -z "$DYLD_LIBRARY_PATH" ]; then
  # Try common homebrew locations
  if [ -d "/opt/homebrew/Cellar/duckdb" ]; then
    DYLD_LIBRARY_PATH=$(ls -d /opt/homebrew/Cellar/duckdb/*/lib 2>/dev/null | head -1)
  fi

  # Fallback to /usr/local for Intel Macs
  if [ -z "$DYLD_LIBRARY_PATH" ] && [ -d "/usr/local/Cellar/duckdb" ]; then
    DYLD_LIBRARY_PATH=$(ls -d /usr/local/Cellar/duckdb/*/lib 2>/dev/null | head -1)
  fi

  # Export if we found a path
  if [ -n "$DYLD_LIBRARY_PATH" ]; then
    export DYLD_LIBRARY_PATH
  fi
fi

# Get the absolute directory of this script, resolving symlinks
SCRIPT_DIR="$0"
# If $0 is relative, make it absolute from current directory
case "$SCRIPT_DIR" in
  /*) ;;
  *)  SCRIPT_DIR="$(pwd)/$SCRIPT_DIR";;
esac
# Resolve symlinks
while [ -L "$SCRIPT_DIR" ]; do
  SCRIPT_DIR=$(readlink "$SCRIPT_DIR")
  case "$SCRIPT_DIR" in
    /*) ;;
    *)  SCRIPT_DIR="$(pwd)/$SCRIPT_DIR";;
  esac
done
SCRIPT_DIR="$(dirname "$SCRIPT_DIR")"

# Run the compiled bun executable
exec bun "$SCRIPT_DIR/buckdb.mjs" "$@"
